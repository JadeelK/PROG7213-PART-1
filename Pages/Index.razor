@page "/"

<PageTitle>Smart-X Gateway</PageTitle>

<div class="gateway-container">
    <div class="gateway-header">
        <h1>Smart-X IoT Mesh Ecosystem</h1>
        <p class="subtitle">Select an architectural pillar to continue</p>
    </div>

    <div class="pillar-grid">
        <a class="pillar-card active" href="/sensors">
            <div class="pillar-icon">📡</div>
            <h2>Sensor Data Ingestion and Telemetry</h2>
            <p>Register sensors, ingest mock telemetry, and monitor network health in real time.</p>
            <span class="pillar-badge">Available Now</span>
        </a>

        <div class="pillar-card disabled">
            <div class="pillar-icon">⚡</div>
            <h2>Real-Time Command Stream and History</h2>
            <p>Coming in Part 2.</p>
            <span class="pillar-badge disabled-badge">Coming Soon</span>
        </div>

        <div class="pillar-card disabled">
            <div class="pillar-icon">🕸️</div>
            <h2>Network Topology and Mesh Routing</h2>
            <p>Coming in the final POE.</p>
            <span class="pillar-badge disabled-badge">Coming Soon</span>
        </div>
    </div>
</div>

<style>
    .gateway-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .gateway-header {
        text-align: center;
        margin-bottom: 48px;
    }

        .gateway-header h1 {
            font-size: 2.4rem;
            font-weight: 700;
            color: #1a365d;
            margin-bottom: 8px;
        }

    .subtitle {
        color: #4a5568;
        font-size: 1.15rem;
    }

    .pillar-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 28px;
    }

    .pillar-card {
        display: flex;
        flex-direction: column;
        padding: 28px 24px;
        border-radius: 16px;
        text-decoration: none;
        color: inherit;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.07);
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
    }

        .pillar-card.active {
            border-color: #3182ce;
            background: linear-gradient(145deg, #ebf8ff 0%, #bee3f8 100%);
            cursor: pointer;
        }

            .pillar-card.active:hover {
                transform: translateY(-6px);
                box-shadow: 0 12px 20px -5px rgba(49, 130, 206, 0.25);
            }

        .pillar-card.disabled {
            background: #f7fafc;
            color: #a0aec0;
            cursor: not-allowed;
        }

    .pillar-icon {
        font-size: 2.2rem;
        margin-bottom: 16px;
    }

    .pillar-card h2 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 10px;
        color: #2d3748;
    }

    .pillar-card.disabled h2 {
        color: #a0aec0;
    }

    .pillar-card p {
        flex-grow: 1;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 20px;
        color: #4a5568;
    }

    .pillar-card.disabled p {
        color: #cbd5e0;
    }

    .pillar-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        background: #3182ce;
        color: white;
        align-self: flex-start;
    }

    .disabled-badge {
        background: #a0aec0;
    }
</style>